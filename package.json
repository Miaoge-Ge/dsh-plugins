{
  "name": "dsh-plugins",
  "version": "0.0.1",
  "private": true,
  "description": "DeepSeek Harness 插件合集：用量与消费、主题工坊、Code 模式",
  "type": "module",
  "workspaces": ["dsh-session-cost", "dsh-theme-atelier", "dsh-code-mode-preset"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "node scripts/validate.mjs && npm run check --workspaces --if-present",
    "pack:plugins": "node scripts/pack.mjs"
  },
  "engines": {"node": ">=20"},
  "repository": {"type": "git", "url": "https://github.com/Miaoge-Ge/dsh-plugins.git"},
  "devDependencies": {"yaml": "^2.8.1"}
}
