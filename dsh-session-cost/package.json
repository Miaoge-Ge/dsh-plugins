{
  "name": "@local/session-cost",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness usage dashboard: today/month spending computed per call from the official price list, account balance, per-model token accounting and CSV export.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miaoge-Ge/dsh-plugins.git",
    "directory": "dsh-session-cost"
  },
  "homepage": "https://github.com/Miaoge-Ge/dsh-plugins/tree/main/dsh-session-cost#readme",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node --check client.js && node --check index.js && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "bugs": {
    "url": "https://github.com/Miaoge-Ge/dsh-plugins/issues"
  }
}
